# Copy this file to .env and fill in real values. Never commit .env.

# --- Upstream: Piano.io's MCP server ---
# The remote MCP endpoint Piano.io exposes (see https://docs.piano.io/en/analytics/mcp).
PIANO_MCP_URL=https://analytics-api-eu.piano.io/mcp/
# Transport Piano's server speaks: "streamable-http" (default, current MCP spec)
# or "sse" (legacy transport, use only if Piano's server requires it).
PIANO_MCP_TRANSPORT=streamable-http

# --- Downstream: this wrapper, as exposed to Claude Enterprise ---
# Port the wrapper listens on.
PORT=3333

# NOTE: there is no shared Piano credential to set here. Each caller sends
# their own personal Piano key pair - from
# https://analytics.piano.io/profile/#/apikeys - as their own connector auth
# token: "Authorization: Bearer <ACCESS_KEY>_<SECRET_KEY>". The wrapper only
# forwards that value on to Piano's x-api-key header per request; it never
# stores it. This is what makes each employee see their own default site's
# data instead of one shared org-wide site.
